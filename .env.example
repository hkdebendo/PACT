# PACT environment. Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# `npm run env:check` prints which variables are set (never their values).

# --- PayPal (sandbox only) -------------------------------------------------------------
# sandbox   = real PayPal sandbox calls (needs the two values below)
# simulated = SIMULATED in-process PayPal adapter, clearly labelled in the UI. Use it to try PACT
#             with no PayPal account; it is NOT real PayPal behaviour.
PAYPAL_ENV=sandbox
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional. Webhooks need a public URL; without it PACT uses its reconciliation poller.
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) test account, used only by the Playwright demo automation.
# developer.paypal.com > Testing Tools > Sandbox Accounts. Never a real account.
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# --- AI (Meta Model API, Muse) ---------------------------------------------------------
# Key from https://dev.meta.ai
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# live   = call Muse and record every response to fixtures/llm-cache/
# replay = serve recorded responses only (no key needed); unknown inputs fail with a clear message
LLM_MODE=live
# minimal | low | medium | high | xhigh
MUSE_REASONING_EFFORT=medium

# --- AG Studio -------------------------------------------------------------------------
# 45-day trial: https://www.ag-grid.com/studio/react/enterprise-licence/#request-a-45-day-trial-licence
AG_STUDIO_LICENSE_KEY=

# --- App -------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=file:./data/pact.db
# Comma-separated name:key pairs for MCP agents, e.g. buyer-agent:<random>,seller-agent:<random>
AGENT_API_KEYS=
